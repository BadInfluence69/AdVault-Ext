{
  "manifest_version": 3,
  "name": "AdVault",
  "version": "0.6.3",
  "author": "Briam Cambron",
  "description": "Blocks ad and malvertising requests before they execute, hides what is left, and skips the ads inside video players. Built against the no-click path: nothing loads, so nothing runs.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "AdVault",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "core",
        "enabled": true,
        "path": "rules/net_core.json"
      },
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/net_ads.json"
      },
      {
        "id": "ads_extra",
        "enabled": true,
        "path": "rules/net_ads_extra.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/inject.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/settings.js",
        "src/cosmetic.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/settings.js",
        "src/sites.js",
        "src/content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "<all_urls>"
      ],
      "js": [
        "src/settings.js",
        "src/ubo-procedural.js",
        "src/adframes.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
       "<all_urls>"
      ],
      "js": [
        "src/settings.js",
        "src/yt-recover.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/settings.js",
        "src/sites.js",
        "src/dvr-skip.js"
      ],
      "all_frames": false,
      "run_at": "document_idle"
    }
  ]
}
